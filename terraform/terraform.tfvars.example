# AWS Infrastructure Settings
aws_region    = "us-east-1"
instance_type = "t2.micro"
instance_name = "devops-assessment-vm"

# SSH Settings
# Create this key pair in your AWS Console before running terraform apply
key_name      = "your-key-pair-name"

